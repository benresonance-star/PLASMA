{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plasma.local/system-atlas/atlas.schema.json",
  "title": "Plasma System Atlas",
  "type": "object",
  "required": [
    "meta",
    "views",
    "components",
    "relationships",
    "contracts",
    "languages",
    "transactions",
    "slices",
    "evidence",
    "links",
    "integration"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "id",
        "version",
        "title",
        "status",
        "description",
        "principles"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      }
    },
    "languages": {
      "type": "object",
      "required": [
        "domain",
        "crossCutting",
        "futureDomains",
        "contractShape",
        "operationLevels",
        "interactionRule"
      ],
      "properties": {
        "domain": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/language"
          }
        },
        "crossCutting": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coreLanguage"
          }
        },
        "futureDomains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contractShape": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operationLevels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "examples",
              "description"
            ]
          }
        },
        "interactionRule": {
          "type": "string"
        }
      }
    },
    "transactions": {
      "type": "object",
      "required": [
        "principle",
        "stages",
        "candidatePatch",
        "validation",
        "rejectionPaths",
        "invariants",
        "freshnessStates"
      ]
    },
    "slices": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slice"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "integration": {
      "type": "object",
      "required": [
        "principle",
        "matrixRows",
        "architectureStates",
        "evidenceStates"
      ],
      "properties": {
        "principle": {
          "type": "string"
        },
        "matrixRows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "ref"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "ref": {
                "$ref": "#/$defs/typedRef"
              }
            },
            "additionalProperties": false
          }
        },
        "architectureStates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "evidenceStates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "view": {
      "type": "object",
      "required": [
        "id",
        "label",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "atlasId",
        "name",
        "kind",
        "authority",
        "band",
        "summary",
        "explanation",
        "status",
        "owner",
        "contracts",
        "dependencies",
        "evidence",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "atlasId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "band": {
          "enum": [
            "intent",
            "authority",
            "execution",
            "projection"
          ]
        },
        "summary": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "contracts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "contract",
        "direction",
        "label",
        "payload",
        "mode",
        "authoritySemantics",
        "failure",
        "explanation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "contract": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "forward",
            "bidirectional"
          ]
        },
        "label": {
          "type": "string"
        },
        "payload": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "authoritySemantics": {
          "type": "string"
        },
        "failure": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "contract": {
      "type": "object",
      "required": [
        "id",
        "name",
        "from",
        "to",
        "input",
        "output",
        "semantics",
        "failure",
        "explanation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "input": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "semantics": {
          "type": "string"
        },
        "failure": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "language": {
      "type": "object",
      "required": [
        "id",
        "atlasId",
        "name",
        "summary",
        "explanation",
        "types",
        "verbs",
        "constraints",
        "uses",
        "maturity"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "atlasId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "verbs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maturity": {
          "enum": [
            "active",
            "emerging",
            "planned",
            "research"
          ]
        }
      },
      "additionalProperties": false
    },
    "coreLanguage": {
      "type": "object",
      "required": [
        "id",
        "atlasId",
        "name",
        "verb",
        "summary",
        "explanation"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "atlasId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "verb": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "slice": {
      "type": "object",
      "required": [
        "id",
        "name",
        "domain",
        "summary",
        "purpose",
        "whyThisSlice",
        "flow",
        "proves",
        "stressPoints",
        "successCriteria",
        "keySystems",
        "declaredState",
        "evidenceState",
        "checks",
        "explanation",
        "integrationEvidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "whyThisSlice": {
          "type": "string"
        },
        "flow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 4
        },
        "proves": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3
        },
        "stressPoints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3
        },
        "successCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3
        },
        "keySystems": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "declaredState": {
          "type": "string"
        },
        "evidenceState": {
          "type": "string"
        },
        "checks": {
          "type": "object"
        },
        "explanation": {
          "type": "string"
        },
        "integrationEvidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "supports",
        "description",
        "claim",
        "verification"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "description": {
          "type": "string"
        },
        "claim": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/acceptanceCriterion"
          }
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      },
      "additionalProperties": false
    },
    "typedRef": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "component",
            "relationship",
            "contract",
            "domainLanguage",
            "coreLanguage",
            "stage",
            "slice",
            "evidence"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "role",
        "architectureState",
        "criticality",
        "evidencePolicy",
        "evidenceRefs"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/typedRef"
        },
        "to": {
          "$ref": "#/$defs/typedRef"
        },
        "role": {
          "type": "string"
        },
        "architectureState": {
          "enum": [
            "defined",
            "partial",
            "planned"
          ]
        },
        "criticality": {
          "enum": [
            "core",
            "supporting"
          ]
        },
        "explanation": {
          "type": "string"
        },
        "evidencePolicy": {
          "$ref": "#/$defs/evidencePolicy"
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        }
      },
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "required": [
        "id",
        "requirement"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "requirement": {
          "enum": [
            "required",
            "supporting"
          ]
        },
        "proves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidencePolicy": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "all-required",
            "any-required",
            "threshold"
          ]
        },
        "minimumVerified": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "status",
        "method",
        "source",
        "subjectRevision",
        "verifiedAt",
        "result"
      ],
      "properties": {
        "status": {
          "enum": [
            "unlinked",
            "linked",
            "verified",
            "failed",
            "stale",
            "superseded"
          ]
        },
        "method": {
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "subjectRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "acceptanceCriterion": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
