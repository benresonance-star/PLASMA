{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plasma.local/repository-evidence.schema.json",
  "title": "PLASMA Atlas Repository Evidence Contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "repository",
    "workflow",
    "bindings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "repository": {
      "type": "object",
      "required": [
        "provider",
        "owner",
        "name",
        "defaultBranch"
      ],
      "properties": {
        "provider": {
          "const": "github"
        },
        "owner": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "defaultBranch": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "required": [
        "file",
        "name",
        "job"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "job": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "binding": {
      "type": "object",
      "required": [
        "id",
        "evidenceId",
        "sources",
        "tests",
        "ci",
        "freshnessPolicy"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "evidenceId": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "role",
              "paths"
            ],
            "properties": {
              "role": {
                "enum": [
                  "implementation",
                  "contract",
                  "test",
                  "fixture",
                  "benchmark",
                  "schema",
                  "workflow",
                  "adapter"
                ]
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "framework",
              "paths",
              "step"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "framework": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "step": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "ci": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "workflow",
                "job",
                "step"
              ],
              "properties": {
                "workflow": {
                  "type": "string"
                },
                "job": {
                  "type": "string"
                },
                "step": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "freshnessPolicy": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "source-change"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "mode",
                "maxAgeHours"
              ],
              "properties": {
                "mode": {
                  "enum": [
                    "max-age",
                    "source-change-or-max-age"
                  ]
                },
                "maxAgeHours": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "mode"
              ],
              "properties": {
                "mode": {
                  "const": "manual-expiry"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
