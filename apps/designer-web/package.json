    "three": "0.185.1"
  },
  "devDependencies": {
    "@spds/analysis-worker": "workspace:*",
    "@spds/reference-pipeline": "workspace:*",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.22.0",
    "jsdom": "26.1.0",
    "typescript": "^5.8.2",
    "vite": "6.3.5",
    "vitest": "^3.0.8"
