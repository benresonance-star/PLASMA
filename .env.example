# Copy to .env for local overrides (never commit .env)
POSTGRES_USER=spds
POSTGRES_PASSWORD=spds
POSTGRES_DB=spds
POSTGRES_URL=postgres://spds:spds@localhost:5432/spds
MINIO_ROOT_USER=spdsminio
MINIO_ROOT_PASSWORD=spdsminio
MINIO_ENDPOINT=http://localhost:9000
SPDS_MINIO_ENDPOINT=http://localhost:9000
SPDS_MINIO_ACCESS_KEY=spdsminio
SPDS_MINIO_SECRET_KEY=spdsminio
SPDS_MINIO_BUCKET=spds-artifacts
NODE_OPTIONS=--use-system-ca
GEOMETRY_KERNEL=exact-adapter
# GEOMETRY_KERNEL=occt-wasm
SPDS_GMSH_BIN=gmsh
SPDS_GMSH_IMAGE=spds-gmsh
# SPDS_GMSH_DOCKER=0
# SPDS_REQUIRE_LIVE_GMSH=1
