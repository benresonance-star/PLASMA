{
  "id": "pattern:goldberg-cellular-topology",
  "version": "1.0.0",
  "name": "Goldberg Cellular Topology",
  "lifecycle": "published",
  "intent": [
    "create class-I Goldberg cellular organisation over a spherical surface",
    "emit retained/boundary Y-network for fabrication"
  ],
  "applicableTo": ["dome", "spherical-shell"],
  "requires": ["topology.goldberg.class-i@1.0.0", "topology.y-network@1.0.0"],
  "parameters": {
    "frequency": {
      "semanticId": "param:goldberg:frequency",
      "path": "params.frequency",
      "type": "integer",
      "unit": "1",
      "min": 1,
      "max": 8,
      "default": 2,
      "role": "design-variable",
      "editableBy": ["user", "agent"],
      "aliases": ["param:d01:frequency"],
      "label": "Subdivision frequency",
      "group": "Topology"
    },
    "diameterMm": {
      "semanticId": "param:goldberg:diameter",
      "path": "params.diameterMm",
      "type": "number",
      "unit": "mm",
      "min": 1,
      "max": 100000,
      "default": 20000,
      "role": "design-variable",
      "editableBy": ["user", "agent"],
      "aliases": ["param:d01.diameter", "param:d01:diameter"],
      "label": "Diameter",
      "group": "Envelope"
    },
    "riseRatio": {
      "semanticId": "param:goldberg:rise-ratio",
      "path": "params.riseRatio",
      "type": "number",
      "unit": "1",
      "min": 0,
      "max": 1,
      "default": 0.5,
      "role": "design-variable",
      "editableBy": ["user", "agent"],
      "aliases": ["param:d01:riseRatio"],
      "label": "Rise ratio",
      "group": "Envelope"
    },
    "lengthMm": {
      "semanticId": "param:d01:length",
      "path": "lengthMm",
      "type": "number",
      "unit": "mm",
      "min": 500,
      "max": 4000,
      "default": 2300,
      "role": "design-variable",
      "editableBy": ["user", "agent"],
      "aliases": ["param:d01:lengthMm", "y:demo:01"],
      "label": "Member length",
      "group": "Y profile"
    },
    "armWidthMm": {
      "semanticId": "param:d01:armWidth",
      "path": "armWidthMm",
      "type": "number",
      "unit": "mm",
      "min": 20,
      "max": 400,
      "default": 80,
      "role": "design-variable",
      "editableBy": ["user", "agent"],
      "aliases": ["param:d01:armWidthMm"],
      "label": "Arm width",
      "group": "Y profile"
    },
    "structuralDepthMm": {
      "semanticId": "param:d01:structuralDepth",
      "path": "structuralDepthMm",
      "type": "number",
      "unit": "mm",
      "min": 40,
      "max": 600,
      "default": 120,
      "role": "design-variable",
      "editableBy": ["user", "agent"],
      "aliases": ["param:d01:structuralDepthMm"],
      "label": "Structural depth",
      "group": "Y profile"
    }
  },
  "operators": [
    "topology.goldberg.class-i@1.0.0",
    "semantic.bind@1.0.0",
    "topology.y-network@1.0.0"
  ]
}
