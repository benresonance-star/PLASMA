{
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "id",
    "version",
    "status",
    "purpose",
    "rules",
    "projection"
  ],
  "properties": {
    "apiVersion": {
      "const": "plasma.spec/v1"
    },
    "kind": {
      "const": "ArchitectureCouncil"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "object",
      "required": [
        "architecture",
        "specification",
        "implementation",
        "verification",
        "release"
      ]
    },
    "projection": {
      "type": "object",
      "required": [
        "view",
        "authority",
        "implementationStatus",
        "executionStatus",
        "roles",
        "decisions"
      ],
      "properties": {
        "view": {
          "type": "object",
          "required": [
            "id",
            "label",
            "description"
          ],
          "properties": {
            "id": {
              "const": "council"
            },
            "label": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "authority": {
          "const": "development-governance-only"
        },
        "implementationStatus": {
          "const": "not_started"
        },
        "executionStatus": {
          "const": "none"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "phase",
              "summary",
              "responsibilities",
              "learning",
              "components",
              "contracts",
              "authority",
              "executionStatus",
              "forbidden"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "phase": {
                "enum": [
                  "initial",
                  "deferred"
                ]
              },
              "summary": {
                "type": "string"
              },
              "responsibilities": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "learning": {
                "type": "string"
              },
              "components": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "contracts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "authority": {
                "const": "review_only"
              },
              "executionStatus": {
                "const": "not_started"
              },
              "forbidden": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "status",
              "reviewStatus",
              "approvalStatus",
              "summary",
              "problem",
              "alternatives",
              "affectedRefs",
              "stages",
              "evidenceRefs"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "illustrative",
                  "proposed",
                  "superseded"
                ]
              },
              "reviewStatus": {
                "const": "not_run"
              },
              "approvalStatus": {
                "const": "not_requested"
              },
              "summary": {
                "type": "string"
              },
              "problem": {
                "type": "string"
              },
              "alternatives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "status",
                    "tradeoff"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "status": {
                      "const": "unassessed"
                    },
                    "tradeoff": {
                      "type": "string"
                    }
                  }
                }
              },
              "affectedRefs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "id"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "component",
                        "contract"
                      ]
                    },
                    "id": {
                      "type": "string"
                    }
                  }
                }
              },
              "stages": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "roleIds",
                    "status",
                    "question",
                    "output"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "roleIds": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "status": {
                      "const": "not_run"
                    },
                    "question": {
                      "type": "string"
                    },
                    "output": {
                      "type": "string"
                    }
                  }
                }
              },
              "evidenceRefs": {
                "type": "array"
              }
            }
          }
        }
      }
    }
  }
}
