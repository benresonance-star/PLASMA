{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plasma.local/spec/v1/domain.schema.json",
  "type": "object",
  "additionalProperties": true,
  "title": "Plasma Domain Pack",
  "required": [
    "apiVersion",
    "kind",
    "id",
    "version",
    "title",
    "layer",
    "status",
    "dependsOn"
  ],
  "properties": {
    "kind": {
      "const": "DomainPack"
    },
    "layer": {
      "const": "L4"
    },
    "status": {
      "type": "object",
      "required": [
        "architecture",
        "specification",
        "implementation",
        "verification",
        "release"
      ],
      "properties": {
        "architecture": {
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "specification": {
          "enum": [
            "absent",
            "draft",
            "partial",
            "complete",
            "frozen",
            "superseded"
          ]
        },
        "implementation": {
          "enum": [
            "not_started",
            "experimental",
            "partial",
            "implemented",
            "deprecated"
          ]
        },
        "verification": {
          "enum": [
            "none",
            "unlinked",
            "partial",
            "verified",
            "failed",
            "stale"
          ]
        },
        "release": {
          "enum": [
            "excluded",
            "candidate",
            "released",
            "deprecated"
          ]
        }
      },
      "additionalProperties": false
    },
    "dependsOn": {
      "type": "array"
    }
  }
}
